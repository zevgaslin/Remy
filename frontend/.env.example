# Backend API base URL. Defaults to http://localhost:8080/api if unset,
# which only works when the backend runs on the same machine as the browser.
# To test from another device (e.g. a phone), set this to the backend
# machine's LAN IP, e.g.:
# VITE_API_BASE_URL=http://192.168.1.23:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
