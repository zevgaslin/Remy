{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remy recipe file, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "cuisine",
    "mealType",
    "difficulty",
    "prepMinutes",
    "cookMinutes",
    "totalMinutes",
    "servings",
    "yieldText",
    "ingredients",
    "instructions",
    "preferenceTags",
    "keywords",
    "nutrition",
    "imageUrl",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "cuisine": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "mealType": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "difficulty": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "prepMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cookMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "totalMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "servings": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "yieldText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "originalText",
          "quantity",
          "quantityText",
          "unit",
          "preparation",
          "section",
          "optional"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "originalText": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "quantityText": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "preparation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "section": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "section"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "section": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "preferenceTags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "nutrition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "basis",
        "estimated",
        "calories",
        "protein",
        "carbs",
        "fat"
      ],
      "properties": {
        "basis": {
          "const": "per-serving"
        },
        "estimated": {
          "type": "boolean"
        },
        "calories": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "protein": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "carbs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "imageUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https?://"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "siteName",
        "author",
        "importedAt",
        "originalInstructions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "website",
            "manual",
            "legacy-seed"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "siteName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "author": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "importedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "originalInstructions": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "website"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "importedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
