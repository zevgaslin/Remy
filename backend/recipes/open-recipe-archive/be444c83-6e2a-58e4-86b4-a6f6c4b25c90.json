  "instructions": [
    {
      "text": "Take 12 large potatoes, peel boil and mash fine.",
      "section": null
    },
    {
      "text": "Take 2 3/4 cups flour and 2 tablespoons brown sugar and 1 tablespoon salt, and scald this with 1 quart boiling water.",
      "section": null
    },
    {
      "text": "Mix well, then add the potato water, then 1 quart of cold water.",
      "section": null
    },
    {
      "text": "Put 2 White Swan Yeast Cakes to soak in a little warm water and when the yeast is lukewarm, put the yeast cakes in and let rise.",
      "section": null
    },
    {
      "text": "One cup of yeast and 1 of water makes 1 loaf.",
      "section": null
    }
