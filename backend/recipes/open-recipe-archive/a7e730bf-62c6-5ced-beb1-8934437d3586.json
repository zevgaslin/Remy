  "instructions": [
    {
      "text": "Boil a quart of milk, and make it into a thick batter, with arrow root",
      "section": null
    },
    {
      "text": "Add six eggs, half a pound of butter, the same of pounded sugar, half a nutmeg, and a little grated lemon peel",
      "section": null
    },
    {
      "text": "Put a paste in the dish, and bake it nicely",
      "section": null
    },
    {
      "text": "When done, sift sugar over it, and stick slips of citron all over the top",
      "section": null
    }
