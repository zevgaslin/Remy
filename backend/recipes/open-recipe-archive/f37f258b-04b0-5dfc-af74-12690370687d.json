  "instructions": [
    {
      "text": "Boil half a cupful of rice in just enough water to cover it, with half a teaspoonful of salt",
      "section": null
    },
    {
      "text": "When the water has boiled nearly out and the rice begins to look soft and dry, turn over it a cupful of milk",
      "section": null
    },
    {
      "text": "Let it simmer until the rice is done and nearly dry",
      "section": null
    },
    {
      "text": "Take from the fire and beat in a well-beaten egg",
      "section": null
    },
    {
      "text": "Eat it warm with cream and sugar",
      "section": null
    },
    {
      "text": "Flavor to taste",
      "section": null
    }
