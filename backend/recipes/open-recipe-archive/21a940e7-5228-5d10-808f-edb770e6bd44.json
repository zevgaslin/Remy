  "instructions": [
    {
      "text": "Cream 3/4 cup butter",
      "section": null
    },
    {
      "text": "Add slowly 2 cups sugar and cream together",
      "section": null
    },
    {
      "text": "Sift together 2 teaspoons baking powder with 3 cups flour and a little salt; sift four times",
      "section": null
    },
    {
      "text": "Add 1 tablespoon of the sifted flour to the creamed butter and sugar",
      "section": null
    },
    {
      "text": "Add 4 eggs, 1 at a time unbeaten, adding a tablespoon flour before each egg",
      "section": null
    },
    {
      "text": "Continue adding the flour alternately with 1 cup milk",
      "section": null
    },
    {
      "text": "Flavor with 1 teaspoon orange extract",
      "section": null
    },
    {
      "text": "Bake in a moderate oven until cake shrinks from edge of pan and feels firm",
      "section": null
    },
    {
      "text": "When cool, frost with orange frosting",
      "section": null
    }
