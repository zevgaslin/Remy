  "instructions": [
    {
      "text": "Prepare and cook beef same as for Bouillon.",
      "section": null
    },
    {
      "text": "Cook vegetables in butter five minutes.",
      "section": null
    },
    {
      "text": "Add to soup with remaining seasonings.",
      "section": null
    },
    {
      "text": "Cook one and one-half hours, strain, cool quickly, remove fat, and clear.",
      "section": null
    },
    {
      "text": "When ready to clear, add one cup finely chopped raw beet and one-fourth cup vinegar.",
      "section": null
    },
    {
      "text": "Select red beets for this soup, and serve as soon as possible after clearing, otherwise it will lose its bright red color, which makes the dish especially appropriate for an American Beauty Dinner.",
      "section": null
