  "instructions": [
    {
      "text": "Cook bacon, onion, and carrot five minutes; add bay leaf, thyme, parsley, cloves, peppercorns, nutmeg, and tomatoes, and cook five minutes.",
      "section": null
    },
    {
      "text": "Add flour diluted with enough cold water to pour; as it thickens, dilute with stock.",
      "section": null
    },
    {
      "text": "Cover, and cook in oven one hour.",
      "section": null
    },
    {
      "text": "Strain, add salt and pepper to taste, and one-half can mushrooms, drained from their liquor, rinsed, and cut in quarters; then cook two minutes.",
      "section": null
    },
    {
      "text": "Use fresh mushrooms in place of canned ones when possible.",
      "section": null
    }
