  "instructions": [
    {
      "text": "Flour the fruit thoroughly from a pint of flour",
      "section": null
    },
    {
      "text": "In a large bowl put the well-beaten eggs, sugar, spices and salt in one cupful of milk",
      "section": null
    },
    {
      "text": "Stir in the fruit, chopped nuts, bread crumbs and suet, one after the other, until all are used",
      "section": null
    },
    {
      "text": "Dissolve a level teaspoonful of soda in a tablespoonful of warm water and put in last",
      "section": null
    },
    {
      "text": "Add enough flour to make the fruit stick together, which will take all the pint",
      "section": null
    },
    {
      "text": "Boil or steam four hours",
      "section": null
    },
    {
      "text": "Serve with wine or brandy or any well-flavored sauce",
      "section": null
    }
