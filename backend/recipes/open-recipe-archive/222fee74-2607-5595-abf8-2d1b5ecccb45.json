  "instructions": [
    {
      "text": "Peel, core and cut apples in quarters",
      "section": null
    },
    {
      "text": "Put apples with 3/4 cup sugar and a little water in saucepan and stew until they are about half done",
      "section": null
    },
    {
      "text": "Make a batter of 1 egg, 1 cup sugar, butter size of small egg creamed together",
      "section": null
    },
    {
      "text": "Add 1 cup sweet milk, a heaping teaspoon of baking powder and flour to thicken",
      "section": null
    },
    {
      "text": "Put apples in pudding dish",
      "section": null
    },
    {
      "text": "Pour batter over them and bake",
      "section": null
    },
    {
      "text": "When done spread butter over the pudding and serve with cream",
      "section": null
    }
