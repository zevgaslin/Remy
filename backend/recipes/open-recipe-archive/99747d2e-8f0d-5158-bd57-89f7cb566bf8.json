  "instructions": [
    {
      "text": "Open clams, taking care to retain all the liquor found in shell, also shells to serve up in",
      "section": null
    },
    {
      "text": "Stew in their own liquor for five minutes, cut into pieces the size of peas",
      "section": null
    },
    {
      "text": "Take ham, cut into small dice; place in a small saucepan on fire with sufficient butter to prevent burning",
      "section": null
    },
    {
      "text": "Fry to a light brown color, then add chopped onions, chopped celery; mushrooms, peas; parsley",
      "section": null
    },
    {
      "text": "Mix in the clams and their liquor",
      "section": null
    },
    {
      "text": "Season to taste with red pepper and salt; stew for fifteen minutes",
      "section": null
    },
    {
      "text": "Serve in their own shell made hot, with borders of mashed potatoes and garnished with parsley and lemon",
      "section": null
    }
