  "instructions": [
    {
      "text": "Boil the beef until well done, when cold chop it fine",
      "section": null
    },
    {
      "text": "Chop suet and apples and add to the beef",
      "section": null
    },
    {
      "text": "Mix the sugar and spices and add to them the wine, brandy, lemon and orange juice",
      "section": null
    },
    {
      "text": "Mix the raisins, currants, citron, lemon and orange rinds",
      "section": null
    },
    {
      "text": "Combine gradually the three sets of ingredients, after having added the salt to the liquid part, using a small portion of each until all are used",
      "section": null
    },
    {
      "text": "Pack in stone jars, cover closely, and keep in a dry, cool closet",
      "section": null
    }
