  "instructions": [
    {
      "text": "Boil together pint of milk thickened with flour and cornstarch, a dash of red pepper, a slice of onion, and a blade of mace",
      "section": null
    },
    {
      "text": "Add a head of celery previously cut in pieces, boiled and mashed, in salted water in which boiled",
