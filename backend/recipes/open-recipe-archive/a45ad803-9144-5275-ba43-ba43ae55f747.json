  "instructions": [
    {
      "text": "Wipe two slices of lamb cut one and one-fourth inches thick from centre of leg",
      "section": null
    },
    {
      "text": "Put in hot frying-pan and turn frequently until seared and browned on both sides",
      "section": null
    },
    {
      "text": "Brush over with melted butter",
      "section": null
    },
    {
      "text": "Season with salt and pepper",
      "section": null
    },
    {
      "text": "Bake in casserole dish twenty minutes or until tender",
      "section": null
    },
    {
      "text": "Parboil carrot cut in strips fifteen minutes",
      "section": null
    },
    {
      "text": "Drain and sauté in bacon fat to which has been added finely chopped onion",
      "section": null
    },
    {
      "text": "Add to lamb with potato balls, Brown Sauce, and Sherry wine",
      "section": null
    },
    {
      "text": "Season with pepper to taste",
      "section": null
    },
    {
      "text": "Cook until potatoes are soft",
      "section": null
    },
    {
      "text": "Add onions that have been cooked until soft, then drained and sautéd in butter to which sugar has been added",
      "section": null
    },
    {
      "text": "Serve from casserole dish",
      "section": null
    }
