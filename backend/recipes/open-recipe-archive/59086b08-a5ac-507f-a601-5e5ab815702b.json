  "instructions": [
    {
      "text": "Cream butter and sugar",
      "section": null
    },
    {
      "text": "Stir in lemon and nutmeg",
      "section": null
    },
    {
      "text": "Mix well",
      "section": null
    },
    {
      "text": "Add the milk and whites and flour alternately",
      "section": null
    },
    {
      "text": "Stir in the grated cocoanut swiftly and lightly",
      "section": null
    },
    {
      "text": "Bake in four jelly-cake tins",
      "section": null
    },
    {
      "text": "For filling, blanch the almonds",
      "section": null
    },
    {
      "text": "Let them get cold and dry, then pound in a Wedgewood mortar, adding rose-water as you go",
      "section": null
    },
    {
      "text": "Save about two dozen to shred for the top",
      "section": null
    },
    {
      "text": "Beat whites of four eggs stiff",
      "section": null
    },
    {
      "text": "Stir the almond paste into the icing after it is made",
      "section": null
    },
    {
      "text": "Spread between the cooled cakes",
      "section": null
    },
    {
      "text": "Make that for the top a trifle thicker and lay it on heavily",
      "section": null
    },
    {
      "text": "When it has stiffened somewhat, stick the shred almonds closely over it",
      "section": null
    },
    {
      "text": "Set in the oven to harden, but do not let it scorch",
      "section": null
    }
