  "instructions": [
    {
      "text": "Scald Indian meal with milk or water; boiling milk and water can be used, half and half",
      "section": null
    },
    {
      "text": "When cool add: Graham flour, wheat flour, butter (melted), salt, yeast",
      "section": null
    },
    {
      "text": "Dissolve yeast cake in a cup half full of warm water",
      "section": null
    },
    {
      "text": "Mix at night and let rise",
      "section": null
