  "instructions": [
    {
      "text": "At noon scald 2 cups white flour and let it stand until lukewarm",
      "section": null
    },
    {
      "text": "Add 1 soaked White Swan Yeast Cake",
      "section": null
    },
    {
      "text": "Set in a warm place to rise",
      "section": null
    },
    {
      "text": "At night put 1 3/4 quarts warm water, 1 cup sugar, 4 breadspoons baking syrup and about 1 3/4 sifters white flour with the sponge",
      "section": null
    },
    {
      "text": "Finish setting with Graham flour",
      "section": null
    },
    {
      "text": "In the morning put in 2 handfuls salt and stiffen with white flour",
      "section": null
    },
    {
      "text": "Set to rise",
      "section": null
    },
    {
      "text": "Put in pan and let rise again",
      "section": null
    },
