  "instructions": [
    {
      "text": "Clean, skin, and bone fish.",
      "section": null
    },
    {
      "text": "Add to bones cold water and vegetables, and let simmer twenty minutes.",
      "section": null
    },
    {
      "text": "Strain stock from bones.",
      "section": null
    },
    {
      "text": "Chop fish meat; there should be one and one-half cups.",
      "section": null
    },
    {
      "text": "Add cracker, seasonings, melted butter and egg, then shape in small balls.",
      "section": null
    },
    {
      "text": "Try out pork, add onion, and cook five minutes.",
      "section": null
    },
    {
      "text": "Strain, and add to fat, potatoes, balls, and fish stock, and cook until potatoes are soft.",
      "section": null
    },
    {
      "text": "Thicken milk with butter and flour cooked together.",
      "section": null
    },
    {
      "text": "Combine mixtures, and season highly with salt, pepper, and cayenne.",
      "section": null
    },
    {
      "text": "Add crackers, split and soaked in cold milk.",
      "section": null
    }
  ],
