  "instructions": [
    {
      "text": "Clean a bundle of asparagus, cut off tips and boil in salted water till soft",
      "section": null
    },
    {
      "text": "Boil the stalks twenty minutes in a quart of good stock",
      "section": null
    },
    {
      "text": "Put two ounces of butter in a stew-pan with two ounces of flour, mix smoothly and pour in the hot stock, having previously pulped the asparagus through a sieve",
      "section": null
    },
    {
      "text": "Add one pint of milk",
      "section": null
    },
    {
      "text": "Boil up and skim",
      "section": null
    },
    {
      "text": "Put the tips in a tureen with a gill of cream",
      "section": null
    },
    {
      "text": "Pour in the boiling soup",
      "section": null
    },
    {
      "text": "Season with salt and pepper to taste, and serve",
      "section": null
    }
