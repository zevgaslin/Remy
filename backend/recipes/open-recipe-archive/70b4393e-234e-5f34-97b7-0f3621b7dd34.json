  "instructions": [
    {
      "text": "Put 1 cup flour, 1 cup salt, 1 cup sugar in a dish and mix well together",
      "section": null
    },
    {
      "text": "Put 4 quarts of water in a pot and when boiling put in three large handfuls of hops",
      "section": null
    },
    {
      "text": "Boil thirty minutes, pour on flour, sugar and salt",
      "section": null
    },
    {
      "text": "When cool, put in White Swan Yeast Cake to start with",
      "section": null
    },
    {
      "text": "Boil 12 large potatoes, mash fine, and add to mixture",
      "section": null
    },
    {
      "text": "Cover tight, put in a warm place till it ferments",
      "section": null
    },
    {
      "text": "Shake well before using",
