  "instructions": [
    {
      "text": "For dark part: mix brown sugar, butter, and sour milk",
      "section": null
    },
    {
      "text": "Add flour, raisins, soda dissolved in warm water, molasses, yolks of 3 eggs, cloves, and nutmeg",
      "section": null
    },
    {
      "text": "For white part: mix flour, cornstarch, sweet milk, butter, white sugar, and baking powder",
      "section": null
    },
    {
      "text": "Bake all in four layers",
      "section": null
    },
    {
      "text": "For boiled icing: boil 1 cup white sugar in water enough to dissolve it till it will hair",
      "section": null
    },
    {
      "text": "Beat the white of 1 egg to a stiff froth",
      "section": null
    },
    {
      "text": "Pour the hot sugar on the froth",
      "section": null
    },
    {
      "text": "Flavor to suit the taste and beat till cool enough to stay on the cake",
      "section": null
    },
    {
      "text": "Put layers together with boiled icing",
      "section": null
    }
