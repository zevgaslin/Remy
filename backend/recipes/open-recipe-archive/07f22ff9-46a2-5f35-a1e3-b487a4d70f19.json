  "instructions": [
    {
      "text": "Split five birds, season with salt and pepper",
      "section": null
    },
    {
      "text": "Spread with four tablespoons butter, rubbed until creamy, and mixed with three tablespoons flour",
      "section": null
    },
    {
      "text": "Bake in a hot oven until well browned, basting every four minutes with two tablespoons butter, melted in one-fourth cup water",
      "section": null
    },
    {
      "text": "Chop six boiled chickens' livers, season with salt, pepper, and onion juice",
      "section": null
    },
    {
      "text": "Moisten with melted butter and add one teaspoon finely chopped parsley",
      "section": null
    },
    {
      "text": "Spread mixture on five pieces toasted bread",
      "section": null
    },
    {
      "text": "Arrange a bird on each canapé and garnish with parsley",
      "section": null
    }
