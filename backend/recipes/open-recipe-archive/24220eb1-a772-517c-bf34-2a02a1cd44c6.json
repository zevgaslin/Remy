  "instructions": [
    {
      "text": "Cut large vegetables into small pieces and put into a jar",
      "section": null
    },
    {
      "text": "Pour over them boiling salt water, let stand until cold",
      "section": null
    },
    {
      "text": "Pour into a bag, drain all night",
      "section": null
    },
    {
      "text": "Pour boiling vinegar over them, let stand until cold",
      "section": null
    },
    {
      "text": "Pour off vinegar, put on stove, add 1 tablespoon salt",
      "section": null
    },
    {
      "text": "To each quart of vinegar take 1/4 pound mustard, 1 cup sugar, 2 tablespoons flour, and mix to a smooth paste in cold vinegar",
      "section": null
    },
    {
      "text": "Pour into the boiling vinegar and cook five minutes",
      "section": null
    },
    {
      "text": "Add 1 teaspoon turmeric",
      "section": null
    },
    {
      "text": "Bottle before cold",
