  "instructions": [
    {
      "text": "Mix one cupful of sour cream and one cupful of sour milk with three eggs, well beaten, whites and yolks separately.",
      "section": null
    },
    {
      "text": "Add one teaspoonful of salt and one level teaspoonful of soda, dissolved in a spoonful of water, and enough flour to make a very stiff batter.",
      "section": null
    },
    {
      "text": "Drop by spoonfuls into the broth and boil twenty minutes, or until no raw dough shows on the outside.",
