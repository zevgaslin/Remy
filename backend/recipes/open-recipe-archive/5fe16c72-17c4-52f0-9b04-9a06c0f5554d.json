  "instructions": [
    {
      "text": "Stir together a pound of butter and a pound of sugar",
      "section": null
    },
    {
      "text": "Sift into another pan a pound of flour",
      "section": null
    },
    {
      "text": "Beat six eggs very light, and stir them into the butter and sugar, alternately with the flour and a pint of rich milk or cream",
      "section": null
    },
    {
      "text": "Add a glass of wine, a glass of brandy, a powdered nutmeg, and a table-spoonful of powdered cinnamon",
      "section": null
    },
    {
      "text": "Stir in a small tea-spoonful of soda, or sal-aratus, that has been melted in tepid water",
      "section": null
    },
    {
      "text": "Stir the whole very hard; put it into a buttered tin pan",
      "section": null
    },
    {
      "text": "Bake it in a brisk oven",
      "section": null
    }
