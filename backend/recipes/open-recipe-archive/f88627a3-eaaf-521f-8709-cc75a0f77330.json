  "instructions": [
    {
      "text": "Cook one tablespoon finely chopped shallot and three tablespoons chopped carrot in two tablespoons butter ten minutes, stirring constantly that carrots may not burn.",
      "section": null
    },
    {
      "text": "Add two sprigs thyme, one-half bay leaf, two red peppers from pepper sauce, one teaspoon salt, one and one-third cups Brown Stock, two-thirds cup stewed and strained tomatoes, and three tablespoons Sherry wine.",
      "section": null
    },
    {
      "text": "Add lobster and cook fifteen minutes.",
      "section": null
    },
    {
      "text": "Remove lobster to serving dish, thicken sauce with butter and flour cooked together, and add one and one-half tablespoons brandy.",
      "section": null
    },
    {
      "text": "Pour sauce around lobster, and sprinkle all with finely chopped chives.",
      "section": null
    }
