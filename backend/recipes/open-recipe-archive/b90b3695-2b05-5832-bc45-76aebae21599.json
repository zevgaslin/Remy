  "instructions": [
    {
      "text": "Make the mixture exactly like the recipe for Boston Cream Cakes.",
      "section": null
    },
    {
      "text": "Spread it on buttered pans in oblong pieces about four inches long and one and a half wide, to be laid about two inches apart.",
