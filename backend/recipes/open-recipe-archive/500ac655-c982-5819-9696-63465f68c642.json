  "instructions": [
    {
      "text": "Chop six tablespoonfuls of turtle meat very fine.",
      "section": null
    },
    {
      "text": "Rub to a paste with the yolk of two hard-boiled eggs, a tablespoonful of butter, and if convenient, a little oyster liquor.",
      "section": null
    },
    {
      "text": "Season with cayenne, mace, half a teaspoonful of white sugar and a pinch of salt.",
      "section": null
    },
    {
      "text": "Bind all with a well-beaten egg.",
      "section": null
    },
    {
      "text": "Shape into small balls.",
      "section": null
    },
    {
      "text": "Dip in egg, then powdered cracker.",
      "section": null
    },
    {
      "text": "Fry in butter.",
      "section": null
    },
    {
      "text": "Drop into the soup when it is served.",
      "section": null
