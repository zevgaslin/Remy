  "instructions": [
    {
      "text": "Boil eggs hard and take the yolks",
      "section": null
    },
    {
      "text": "Rub smooth with melted butter, salt, mustard, sugar, and pepper to taste",
      "section": null
    },
    {
      "text": "Add to this mixture milk or cream, stirring it in gradually",
      "section": null
    },
    {
      "text": "Add enough vinegar to thicken it",
      "section": null
    },
    {
      "text": "Boil all together, stirring briskly",
      "section": null
    },
    {
      "text": "Do not mind if it curdles, go on stirring till it gets quite smooth",
      "section": null
    },
    {
      "text": "If no cream is used a tablespoonful of cornstarch dissolved in the milk will help to thicken it to the consistency of batter",
      "section": null
    },
    {
      "text": "Use whites of eggs to garnish salad",
      "section": null
