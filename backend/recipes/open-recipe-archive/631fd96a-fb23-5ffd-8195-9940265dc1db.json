  "instructions": [
    {
      "text": "Mix 1 egg, 1 cup granulated sugar, 1 tablespoon butter, 3/4 cup sweet milk, 2 cups flour, and 2 teaspoons baking powder",
      "section": null
    },
    {
      "text": "Bake in 3 layers",
      "section": null
    },
    {
      "text": "For filling: Mix 1/4 cup granulated sugar, 1 tablespoon flour, yolk of 1 egg, 1 cup sweet milk, and 1 teaspoon banana flavoring",
      "section": null
    },
    {
      "text": "Cook filling till thick, put between layers of cake",
      "section": null
    },
    {
      "text": "Beat the white of the egg and add sugar enough to make icing",
      "section": null
    },
    {
      "text": "Cover the cake with the icing and slice banana over the top",
      "section": null
    },
    {
      "text": "Best while fresh",
      "section": null
    }
