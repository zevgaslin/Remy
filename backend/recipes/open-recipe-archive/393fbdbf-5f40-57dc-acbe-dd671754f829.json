  "instructions": [
    {
      "text": "Mix 1 cup sugar, 2 eggs beaten lightly, a little salt, 1 teaspoon vanilla, 1 cup flour, and 1 teaspoon baking powder",
      "section": null
    },
    {
      "text": "Last of all add 3/4 cup scalded milk with 1 teaspoon butter melted in the milk",
      "section": null
    },
    {
      "text": "Bake",
      "section": null
    },
