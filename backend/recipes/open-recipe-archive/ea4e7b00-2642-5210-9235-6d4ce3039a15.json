  "instructions": [
    {
      "text": "Soak all night, changing the water several times and having the last bath quite hot",
      "section": null
    },
    {
      "text": "Boil tender in hot water with a tablespoonful of vinegar",
      "section": null
    },
    {
      "text": "Take out the bones while hot, and let it cool before picking or shredding it into fine flakes",
      "section": null
    },
    {
      "text": "Heat a cupful of milk",
      "section": null
    },
    {
      "text": "Stir into it a tablespoonful of butter rolled in one of flour",
      "section": null
    },
    {
      "text": "Cook until it thickens well",
      "section": null
    },
    {
      "text": "Take from the fire and add two beaten eggs",
      "section": null
    },
    {
      "text": "When these are well mixed, add the shredded fish, and cook two minutes, stirring steadily",
      "section": null
    },
    {
