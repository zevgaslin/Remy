  "instructions": [
    {
      "text": "Stone raisins, clean currants, blanch almonds",
      "section": null
    },
    {
      "text": "Cut up orange-peel fine",
      "section": null
    },
    {
      "text": "Put all fruit, flour, sugar, and spices into a big basin; set aside",
      "section": null
    },
    {
      "text": "Make paste by rubbing butter into flour with baking powder, making into a stiff dough with water",
      "section": null
    },
    {
      "text": "Roll out thin",
      "section": null
    },
    {
      "text": "Grease tin, line it with paste; keep piece for top of bun",
      "section": null
    },
    {
      "text": "Pour milk into flour and mix also fruit all well together with the hand",
      "section": null
    },
    {
      "text": "It must be just moist, not too thin",
      "section": null
    },
    {
      "text": "Pour all into the tin and lay on top sheet",
      "section": null
    },
    {
      "text": "Dot with fork",
      "section": null
    },
    {
      "text": "Bake for three hours in moderate oven",
      "section": null
    }
