  "instructions": [
    {
      "text": "Boil 12 medium-sized potatoes, have ready in a 2-gallon crock 4 heaping tablespoons flour, 2 heaping tablespoons salt, 2 heaping tablespoons sugar.",
      "section": null
    },
    {
      "text": "Scald with potato water, mash potatoes through colander, then add enough water to make about 1 1/2 gallons, lukewarm.",
      "section": null
    },
    {
      "text": "Add 2 White Swan Yeast Cakes which have been soaked in a little warm water.",
      "section": null
    },
    {
      "text": "Set in a warm place to rise.",
      "section": null
    }
