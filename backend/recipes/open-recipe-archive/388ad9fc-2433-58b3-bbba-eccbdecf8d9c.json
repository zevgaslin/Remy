  "instructions": [
    {
      "text": "Put on the stove in a granite pan just to simmer 1/2 cup vinegar, 3/4 cup cold water, 1 cup white sugar, and 1 teaspoon butter",
      "section": null
    },
    {
      "text": "Beat up 2 eggs; take in another dish, 1 teaspoon mustard, 1/2 teaspoon salt, 3/4 teaspoon black pepper, mix with a little cold vinegar, add this to the eggs and stir into the pan",
      "section": null
    },
    {
      "text": "Stand over it and stir till it boils up, then let get cold and pour over your cabbage, having it chopped up fine",
      "section": null
