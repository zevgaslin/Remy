  "instructions": [
    {
      "text": "Chop eight large onions fine and stir in one cup of salt with one peck of green tomatoes",
      "section": null
    },
    {
      "text": "Let it stand over night",
      "section": null
    },
    {
      "text": "In the morning drain off all the liquor",
      "section": null
    },
    {
      "text": "Take two quarts of water and one of vinegar and boil all together twenty minutes",
      "section": null
    },
    {
      "text": "Drain all through a sieve or colander",
      "section": null
    },
    {
      "text": "Put it back into the kettle again and turn over it two quarts of vinegar, one pound of sugar, half a pound of white mustard seed, two tablespoonfuls of ground pepper, two of cinnamon, one of cloves, two of ginger, one of allspice, and half a teaspoonful of cayenne pepper",
      "section": null
    },
    {
      "text": "Boil all together fifteen minutes or until tender",
      "section": null
    },
    {
      "text": "Stir it often to prevent scorching",
      "section": null
    },
    {
      "text": "Seal in glass jars",
      "section": null
    }
  ],
