  "instructions": [
    {
      "text": "Make sponge same as for white bread",
      "section": null
    },
    {
      "text": "To each loaf add 1 cup walnut meats broken into four or five pieces, 2 tablespoons sugar, 2 tablespoons melted butter, and 1 tablespoon caraway seed",
      "section": null
    },
    {
      "text": "Mix in flour same as for white bread",
      "section": null
    },
    {
      "text": "Turn out on board and knead until the dough does not stick to hands",
