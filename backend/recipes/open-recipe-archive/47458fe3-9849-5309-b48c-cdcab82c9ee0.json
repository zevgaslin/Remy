  "instructions": [
    {
      "text": "Chop sufficient cold cooked beef to make 1 pint",
      "section": null
    },
    {
      "text": "Add to it 1 teaspoon salt, 1 teaspoon onion juice, a dash of cayenne, 3/4 teaspoon pepper, and a grating of nutmeg",
      "section": null
    },
    {
      "text": "Put half a pint of milk over the fire",
      "section": null
    },
    {
      "text": "Rub together 1 tablespoon butter and 2 tablespoons flour",
      "section": null
    },
    {
      "text": "Add to the hot milk and stir until you have a smooth, thick paste",
      "section": null
    },
    {
      "text": "Take from the fire and mix with it the meat",
      "section": null
    },
    {
      "text": "Let cool",
      "section": null
    },
    {
      "text": "When cool, form in croquettes",
      "section": null
    },
    {
      "text": "Beat 1 egg and add to it",
      "section": null
    }
