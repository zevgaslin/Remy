  "instructions": [
    {
      "text": "Remove meat from bones.",
      "section": null
    },
    {
      "text": "Cover bones with cold water, add vegetables and seasonings, and heat slowly to boiling-point.",
      "section": null
    },
    {
      "text": "Add meat, boil five minutes, and let simmer until meat is tender; remove meat and reduce stock to two cups.",
      "section": null
    },
    {
      "text": "Put ham in frying-pan, cover with lukewarm water, and let stand on back of range one hour.",
      "section": null
    },
    {
      "text": "Brown butter, add flour, and when well browned add stock; then add veal and ham each cut into cubes.",
      "section": null
    },
    {
      "text": "Let simmer twenty minutes and add oysters.",
      "section": null
    },
    {
      "text": "Put in serving dish and cover with top made of puff paste.",
      "section": null
    }
