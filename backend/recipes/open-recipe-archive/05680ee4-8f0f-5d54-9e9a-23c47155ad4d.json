  "instructions": [
    {
      "text": "Wipe meat and cut in inch cubes.",
      "section": null
    },
    {
      "text": "Put one-half in kettle with marrow-bone, water, and tomatoes.",
      "section": null
    },
    {
      "text": "Brown remaining half in hot frying-pan with some marrow from bone, then turn into kettle.",
      "section": null
    },
    {
      "text": "Heat slowly to boiling-point, and cook at temperature just below boiling-point five hours.",
      "section": null
    },
    {
      "text": "Cook ham and vegetables with butter five minutes, then add to soup with peppercorns, salt, parsley, and bay leaf.",
      "section": null
    },
    {
      "text": "Cook one and one-half hours, strain, cool quickly, remove fat, and clear.",
      "section": null
    }
