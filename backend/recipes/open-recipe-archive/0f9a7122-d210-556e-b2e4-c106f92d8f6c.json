  "instructions": [
    {
      "text": "Clean two young rabbits and cut into joints",
      "section": null
    },
    {
      "text": "Soak in salt and water for half an hour",
      "section": null
    },
    {
      "text": "Put into a saucepan with a pint of cold water, a bunch of sweet herbs, an onion finely minced, a pinch of mace, half a nutmeg, a pinch of pepper and half a pound of salt pork cut in small thin slices",
      "section": null
    },
    {
      "text": "Cover and stew until tender",
      "section": null
    },
    {
      "text": "Take out the rabbits and set in a dish where they will keep warm",
      "section": null
    },
    {
      "text": "Add to the gravy a cup of cream or milk, two well-beaten eggs stirred in a little at a time, a tablespoonful of butter, and a thickening made of a tablespoonful of flour and a little milk",
      "section": null
    },
    {
      "text": "Boil up once and remove the saucepan from the fire",
      "section": null
    },
    {
      "text": "Squeeze in the juice of a lemon while stirring",
      "section": null
    },
    {
      "text": "Pour over the rabbits",
      "section": null
    }
