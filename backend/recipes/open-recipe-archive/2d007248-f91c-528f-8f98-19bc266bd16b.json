  "instructions": [
    {
      "text": "Stir together 1 pint new milk (warm), 1/2 cup sugar, butter size of an egg, 1 White Swan Yeast Cake and flour enough to make a thick paste with 1/2 teaspoon salt",
      "section": null
    },
    {
      "text": "Let rise over night",
      "section": null
    },
    {
      "text": "Knead in the morning the same as bread",
      "section": null
    },
    {
      "text": "Keep in a warm place",
      "section": null
    },
    {
      "text": "When ready to rise the last time, roll out lightly on the breadboard quite thick",
      "section": null
    },
    {
      "text": "Dip in melted butter and lard",
      "section": null
    },
    {
      "text": "Let rise till very light",
      "section": null
    },
    {
      "text": "Bake 3/4 of an hour",
      "section": null
    }
