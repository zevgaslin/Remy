  "instructions": [
    {
      "text": "Boil the prunes in the water and sugar until quite soft.",
      "section": null
    },
    {
      "text": "Take them out and take the stones out, crack the kernels.",
      "section": null
    },
    {
      "text": "Add kernels with the brandy, lemon juice and peel, a little cochineal and the gelatine dissolved in a little water.",
