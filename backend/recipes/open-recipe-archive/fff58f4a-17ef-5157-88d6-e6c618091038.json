  "instructions": [
    {
      "text": "Cut the meat from the bones, and cut off all the fat",
      "section": null
    },
    {
      "text": "Cut meat into small pieces and put into soup pot with one large slice of turnip, two of carrot, one onion and a stalk of celery, all cut fine",
      "section": null
    },
    {
      "text": "Add half a cup of barley and three pints of cold water",
      "section": null
    },
    {
      "text": "Simmer gently two hours",
      "section": null
    },
    {
      "text": "On to the bones put one pint of water; simmer two hours and strain on the soup",
      "section": null
    },
    {
      "text": "Cook a tablespoonful of flour and one of butter together until perfectly smooth",
      "section": null
    },
    {
      "text": "Stir into the soup, and add a teaspoonful of chopped parsley",
      "section": null
    },
    {
      "text": "Season with salt and pepper",
      "section": null
    }
