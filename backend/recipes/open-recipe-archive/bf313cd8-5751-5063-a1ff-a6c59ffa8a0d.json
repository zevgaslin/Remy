  "instructions": [
    {
      "text": "Clean and dress the fowl.",
      "section": null
    },
    {
      "text": "Put into a kettle with boiling water, carrot, turnip, onion, celery, bay leaf, and thyme.",
      "section": null
    },
    {
      "text": "Cook slowly until fowl is tender.",
      "section": null
    },
    {
      "text": "Remove fowl; strain liquor, cool, and skim off fat.",
      "section": null
    },
    {
      "text": "Make a thick sauce, using butter, flour, chicken stock, and cream.",
      "section": null
    },
    {
      "text": "Remove meat from chicken, chop, and moisten with sauce.",
      "section": null
    },
    {
      "text": "Season with salt, cayenne, and slight grating of nutmeg; then add beaten egg.",
      "section": null
    },
    {
      "text": "Cool, shape, crumb, and fry same as other croquettes.",
      "section": null
    },
    {
      "text": "Arrange around a mound of green peas, and serve with Cream Sauce or Wine Jelly.",
      "section": null
    }
