  "instructions": [
    {
      "text": "Stone raisins if not the dressed ones",
      "section": null
    },
    {
      "text": "Wash, dry and pick currants",
      "section": null
    },
    {
      "text": "Mince suet fine",
      "section": null
    },
    {
      "text": "Cut into thin slices the mixed peel",
      "section": null
    },
    {
      "text": "Grate fine the bread crumbs",
      "section": null
    },
    {
      "text": "Sift the flour",
      "section": null
    },
    {
      "text": "Add spices, sugar and salt",
      "section": null
    },
    {
      "text": "Beat the eggs and add the milk",
      "section": null
    },
    {
      "text": "Stir well that everything may be thoroughly blended",
      "section": null
    },
    {
      "text": "Press into buttered moulds or basins",
      "section": null
    },
    {
      "text": "Tie down tightly with a floured cloth",
      "section": null
    },
    {
      "text": "Boil from 6 to 8 hours",
      "section": null
