  "instructions": [
    {
      "text": "Mix all spices, garlic, horseradish, sugar, celery seed, and lemons and set in the sun for three days.",
      "section": null
    },
    {
      "text": "Cut cabbage in quarters—leaving off the outer and green leaves—and put in a kettle of boiling brine.",
      "section": null
    },
    {
      "text": "Cook three minutes.",
      "section": null
    },
    {
      "text": "Take out, drain, and cover thickly with salt.",
      "section": null
    },
    {
      "text": "Spread out in the sun to dry; then shake off the salt, and cover with cold vinegar in which has been steeped enough turmeric to color it well.",
      "section": null
    },
    {
      "text": "Leave it in this two weeks, to draw out the salt and to plump the cabbage.",
      "section": null
    },
    {
      "text": "Pack down in the seasoned vinegar.",
      "section": null
    },
    {
      "text": "Do not use under six weeks or two months.",
      "section": null
    }
  ],
