  "instructions": [
    {
      "text": "Pare and core 6 large apples, filling the cavities with sugar and a bit of butter",
      "section": null
    },
    {
      "text": "Put a little water in a dish, place in the apples and bake",
      "section": null
    },
    {
      "text": "When nearly done, pour a custard around made of 1 pint milk, yolks 2 eggs, 1 level teaspoon cornstarch, sugar and flavor to taste",
      "section": null
    },
    {
      "text": "Put back in the oven and bake",
      "section": null
    },
    {
      "text": "Make a meringue of the 2 whites, and put a tablespoon over each",
      "section": null
    },
    {
      "text": "Brown lightly and eat cold",
      "section": null
    }
