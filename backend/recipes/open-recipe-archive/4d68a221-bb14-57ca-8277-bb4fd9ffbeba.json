  "instructions": [
    {
      "text": "Pare some nice ripe pears",
      "section": null
    },
    {
      "text": "Put them in a saucepan with a few cloves, some lemon or orange peel, and stew about a quarter of an hour in two cupfuls of water",
      "section": null
