  "instructions": [
    {
      "text": "Mix together 2 cups of sugar, 1 cup butter, the yolks of five eggs and whites of two, 1 cup of milk, 3½ cups flour, ⅓ teaspoonful soda, and 1 teaspoonful cream-tartar sifted into the flour.",
      "section": null
    },
    {
      "text": "Bake in jelly-cake tins.",
      "section": null
    },
    {
      "text": "For the filling: Beat together whites of three eggs, 1½ cup sugar, 3 tablespoonfuls grated chocolate, and 1 teaspoonful vanilla well together.",
      "section": null
    },
    {
      "text": "Spread between the layers and on top of cake.",
      "section": null
    }
