  "instructions": [
    {
      "text": "Soak three cupfuls of dried apples over night in cold water enough to swell them",
      "section": null
    },
    {
      "text": "Chop them in the morning and put them on the fire with three cups of molasses",
      "section": null
    },
    {
      "text": "Stew until almost soft",
      "section": null
    },
    {
      "text": "Add a cupful of nice raisins and stew a few moments",
      "section": null
    },
    {
      "text": "When cold, add three cupfuls of flour, one cupful of butter, three eggs and a teaspoonful of soda",
      "section": null
    },
    {
      "text": "Bake in a steady oven",
      "section": null
    },
    {
      "text": "This will make two good-sized panfuls",
