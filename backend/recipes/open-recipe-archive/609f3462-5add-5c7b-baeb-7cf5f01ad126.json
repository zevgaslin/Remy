  "instructions": [
    {
      "text": "Pour hot water over butter, sugar, and salt",
      "section": null
    },
    {
      "text": "When butter and sugar are melted, cool by adding 1 pint of sweet milk",
      "section": null
    },
    {
      "text": "Add flour enough to make a rather stiff batter",
      "section": null
    },
    {
      "text": "Soak White Swan Yeast Cake for 10 minutes in warm water",
      "section": null
    },
    {
      "text": "Stir in yeast cake",
      "section": null
    },
    {
      "text": "Let it stand in warm place over night",
      "section": null
    },
    {
      "text": "In the morning add flour enough to knead into a stiff dough",
      "section": null
    },
    {
      "text": "Let it rise and when light roll out an inch thick",
      "section": null
    },
    {
      "text": "Spread lightly over the top with butter",
      "section": null
    },
    {
      "text": "Cut with small cake cutter",
      "section": null
    },
    {
      "text": "When light, bake in a moderate oven",
      "section": null
    },
    {
      "text": "A cup of currants may be added if desired",
      "section": null
    }
