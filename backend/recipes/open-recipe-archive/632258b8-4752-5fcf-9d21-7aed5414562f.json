  "instructions": [
    {
      "text": "Simmer tomatoes, stock or water, bay leaf, parsley, celery, peppercorns and sugar together until the tomato is thoroughly soft",
      "section": null
    },
    {
      "text": "In another saucepan put a tablespoonful of butter; when it is hot add a sliced onion, and fry, but not brown it",
      "section": null
    },
    {
      "text": "Then add a tablespoonful of flour, and cook, but not brown the flour",
      "section": null
    },
    {
      "text": "To this roux add enough of the tomato to dilute it, and then mix it well with the rest of the tomato, and season with salt",
      "section": null
    },
    {
      "text": "Pass the whole through a fine sieve or strainer",
      "section": null
    },
    {
      "text": "Heat it again before serving, and sprinkle over the top small croutons",
      "section": null
    }
  ],
