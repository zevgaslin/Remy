  "instructions": [
    {
      "text": "Drain the liquor from one can of salmon, and remove the bones and skin",
      "section": null
    },
    {
      "text": "Chop fine and rub into it until smooth, four tablespoonfuls of melted butter, season with salt, pepper and minced parsley, also a little celery, if liked",
      "section": null
    },
    {
      "text": "Beat four eggs well, add half a cupful of cracker-crumbs, mix all well and thoroughly",
      "section": null
    },
    {
      "text": "Put into a buttered mould and steam one hour",
      "section": null
    },
    {
      "text": "For the sauce: Boil one cupful of milk and thicken with one tablespoonful of cornstarch",
      "section": null
    },
    {
      "text": "Add to the liquor from the salmon, one tablespoonful of butter, one egg, and one teaspoonful of catsup",
      "section": null
    },
    {
      "text": "Put the egg in last and very carefully",
      "section": null
    },
    {
      "text": "Boil one minute",
      "section": null
    },
    {
      "text": "Turn the salmon out of the mould and pour the sauce around",
      "section": null
    }
  ],
