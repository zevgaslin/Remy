  "instructions": [
    {
      "text": "Put beef and water into the saucepan and boil for one hour",
      "section": null
    },
    {
      "text": "Meanwhile, slice the onions and fry them in butter to a light brown",
      "section": null
    },
    {
      "text": "Drop into the pot with cloves, pepper, mace, allspice, essence of celery, savory or sweet marjoram, and Worcestershire sauce",
      "section": null
    },
    {
      "text": "Stew all for two hours more, or until the beef has boiled to pieces",
      "section": null
    },
    {
      "text": "Strain the soup and return to the fire",
      "section": null
    },
    {
      "text": "Salt to taste, and just before taking it off, pour in a glass of brown sherry or Madeira wine",
      "section": null
    }
