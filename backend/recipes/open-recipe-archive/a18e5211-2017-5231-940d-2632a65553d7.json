  "instructions": [
    {
      "text": "Boil 1 large handful of hops in a gallon of water for half an hour",
      "section": null
    },
    {
      "text": "Grate 5 medium-sized potatoes and strain the boiling liquid over it, stirring well",
      "section": null
    },
    {
      "text": "Add a little salt, sugar and ginger",
      "section": null
    },
    {
      "text": "Let cool, then add 1 White Swan Yeast Cake and put in a warm place to rise",
      "section": null
    },
    {
      "text": "Stir frequently",
      "section": null
    },
    {
      "text": "It is best made in a large dish and afterwards put into a jar and corked tight",
      "section": null
    }
