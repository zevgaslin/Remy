  "instructions": [
    {
      "text": "Chop fat salt pork fine as almost like lard",
      "section": null
    },
    {
      "text": "Pour 1/2 pint of boiling water on it",
      "section": null
    },
    {
      "text": "Add seeded and chopped raisins and citron shaved into shreds",
      "section": null
    },
    {
      "text": "Add sugar, molasses, saleratus rubbed fine and put into the molasses, and a little salt",
      "section": null
    },
    {
      "text": "Mix all together",
      "section": null
    },
    {
      "text": "Stir in sifted flour to make the consistency of common cake mixture",
      "section": null
    },
    {
      "text": "Add nutmeg, cloves, and cinnamon all finely ground",
      "section": null
    },
    {
      "text": "Bake slowly, testing with a sliver; when nothing adheres, it is done",
      "section": null
    }
