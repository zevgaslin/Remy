  "instructions": [
    {
      "text": "Broil six lamb chops, arrange on slices of fried eggplant.",
      "section": null
    },
    {
      "text": "Brown three tablespoons butter, add three and one-half tablespoons flour, and stir until well browned.",
      "section": null
    },
    {
      "text": "Add, gradually, one cup rich Brown Stock.",
      "section": null
    },
    {
      "text": "Cook three tablespoons lean raw ham cut in small cubes in one-half tablespoon butter two minutes.",
      "section": null
    },
    {
      "text": "Moisten with two tablespoons Sherry wine, and add to sauce with two tablespoons finely shredded green pepper.",
      "section": null
    },
    {
      "text": "Season with salt and pepper.",
      "section": null
    },
    {
      "text": "Pour around the chops.",
      "section": null
    }
