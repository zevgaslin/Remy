  "instructions": [
    {
      "text": "Mix sugar, egg, sweet milk, flour, butter, and baking powder to taste",
      "section": null
    },
    {
      "text": "Divide into three parts and bake in round shallow pans",
      "section": null
    },
    {
      "text": "For Cream: Beat one egg and one-half cup sugar together",
