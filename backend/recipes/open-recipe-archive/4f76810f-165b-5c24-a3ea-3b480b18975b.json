  "instructions": [
    {
      "text": "Take left-over meat and place in baking dish",
      "section": null
    },
    {
      "text": "Add salt and pepper and dredge with flour",
      "section": null
    },
    {
      "text": "Pour over this meat gravy and heat",
      "section": null
    },
    {
      "text": "While this is heating, make a rich biscuit dough by sifting 1 heaping teaspoon baking powder and 1 saltspoon salt into 1 pint flour",
      "section": null
    },
    {
      "text": "Rub in 1 tablespoon lard",
      "section": null
    },
    {
      "text": "Wet with 1 scant cup milk",
      "section": null
    },
    {
      "text": "Drop this by the spoonful on the hot meat from the oven and spread to cover the pie",
      "section": null
    },
    {
      "text": "Bake 3/4 hour",
      "section": null
    }
