  "instructions": [
    {
      "text": "Wipe six French Chops, cut one and one-half inches thick.",
      "section": null
    },
    {
      "text": "Split meat in halves, cutting to bone.",
      "section": null
    },
    {
      "text": "Cook two and one-half tablespoons butter and one tablespoon onion five minutes; remove onion, add one-half cup chopped mushrooms, and cook five minutes.",
      "section": null
    },
    {
      "text": "Add two tablespoons flour, three tablespoons stock, one teaspoon finely chopped parsley, one-fourth teaspoon salt, and a few grains cayenne.",
      "section": null
    },
    {
      "text": "Spread mixture between layers of chops, press together lightly, wrap in buttered paper cases, and broil ten minutes.",
      "section": null
    },
    {
      "text": "Serve with Spanish Sauce.",
      "section": null
    }
