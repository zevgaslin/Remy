  "instructions": [
    {
      "text": "Cook pork with onion and cold water ten minutes; drain, and reserve liquor.",
      "section": null
    },
    {
      "text": "Wash clams and reserve liquor.",
      "section": null
    },
    {
      "text": "Parboil potatoes five minutes, and drain.",
      "section": null
    },
    {
      "text": "To potatoes add reserved liquors, hard part of clams finely chopped, and boiling water.",
      "section": null
    },
    {
      "text": "When potatoes are nearly done, add tomatoes, soda, soft part of clams, milk, cream, and butter.",
      "section": null
    },
    {
      "text": "Season with salt and pepper.",
      "section": null
    },
    {
      "text": "Split crackers, soak in cold milk to moisten, and reheat in chowder.",
      "section": null
    }
