  "instructions": [
    {
      "text": "Put dripping in a pan and heat until smoking hot",
      "section": null
    },
    {
      "text": "Add sliced onion",
      "section": null
    },
    {
      "text": "Cut beefsteak into bits and brown",
      "section": null
    },
    {
      "text": "Shake in flour and brown",
      "section": null
    },
    {
      "text": "Add water and stir slowly",
      "section": null
    },
    {
      "text": "Season and cover",
      "section": null
    },
    {
      "text": "Simmer gently for 2 hours",
      "section": null
    },
    {
      "text": "Add bits of potato and carrot if liked",
      "section": null
    },
    {
      "text": "For biscuits: sift 3 cups flour with 2 teaspoons baking powder and 1/2 teaspoon salt",
      "section": null
    },
    {
      "text": "Rub in 1 tablespoon butter and make into dough with sweet milk",
      "section": null
    },
    {
      "text": "Divide dough in two and pat out (do not knead or roll)",
      "section": null
    },
    {
      "text": "Cut as you would pie and bake",
      "section": null
    },
    {
      "text": "Break open biscuits on a platter and pour meat mixture over",
      "section": null
    },
