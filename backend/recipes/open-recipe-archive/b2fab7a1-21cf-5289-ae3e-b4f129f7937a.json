  "instructions": [
    {
      "text": "Make custard with scalded milk, egg yolks, sugar, and salt",
      "section": null
    },
    {
      "text": "Add gelatine soaked in cold water",
      "section": null
    },
    {
      "text": "Strain and let thicken slightly",
      "section": null
    },
    {
      "text": "Add brandy and vanilla flavoring",
      "section": null
    },
    {
      "text": "Place mould in ice water and decorate bottom with angelica and cherries",
      "section": null
    },
    {
      "text": "Cover with mixture",
      "section": null
    },
    {
      "text": "When firm, add layer of lady fingers soaked in the gelatine mixture, then layer of macaroons",
      "section": null
    },
    {
      "text": "Repeat until mould is full",
      "section": null
    },
    {
      "text": "Serve with cream sauce and garnish with candied cherries",
      "section": null
