  "instructions": [
    {
      "text": "Joint as for fricassee",
      "section": null
    },
    {
      "text": "Pepper, salt, and flour the duck",
      "section": null
    },
    {
      "text": "Heat good dripping in a frying-pan and fry a sliced onion to a light brown",
      "section": null
    },
    {
      "text": "Take out the onion, put in the duck, and cook ten minutes, turning two or three times",
      "section": null
    },
    {
      "text": "Put into a sauce-pan a cupful of stock or consomme, and while it is still cold lay in the jointed duck",
      "section": null
    },
    {
      "text": "Cover and stew slowly until tender",
      "section": null
    },
    {
      "text": "Season with pepper and salt, a tablespoonful of tomato catsup, and a dash of lemon-juice",
      "section": null
    },
    {
      "text": "Simmer three minutes",
      "section": null
    },
    {
      "text": "Stir in a tablespoonful of brown roux",
      "section": null
    },
    {
      "text": "Cook a minute to thicken it",
      "section": null
    },
    {
      "text": "Add a glass of sherry, and serve",
      "section": null
    }
