  "instructions": [
    {
      "text": "Work butter and brown sugar well together",
      "section": null
    },
    {
      "text": "add two teacupfuls of cooking molasses, one cupful of milk with a teaspoonful of soda dissolved in it",
      "section": null
    },
    {
      "text": "add one tablespoonful of ginger, one tablespoonful of cinnamon and one teaspoonful of cloves, a little grated nutmeg",
      "section": null
    },
    {
      "text": "add four eggs well beaten and five cups of sifted flour, or enough to make a stiff batter",
      "section": null
    },
    {
      "text": "Flour a cup of raisins and one of currants",
      "section": null
    },
    {
      "text": "add last",
      "section": null
    },
    {
      "text": "Bake in a very moderate oven one hour",
      "section": null
