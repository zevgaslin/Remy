  "instructions": [
    {
      "text": "Chop or grind the meat and mix the seasoning well through it.",
      "section": null
    },
    {
      "text": "Pack it in beef-skins (or entrails) prepared as you do those of pork.",
      "section": null
    },
    {
      "text": "Tie both ends tightly and lay them in brine strong enough to bear up an egg.",
      "section": null
    },
    {
      "text": "Let them be in this for a week, then change the brine and let them remain in this a week longer.",
      "section": null
    },
    {
      "text": "Turn them over every day of the fortnight.",
      "section": null
    },
    {
      "text": "Take them out, wipe them, and send them to be smoked.",
      "section": null
    },
    {
      "text": "When well smoked, rub them over with sweet oil or fresh butter and hang them in a cool, dark place.",
      "section": null
    },
    {
      "text": "Cut in round, thick slices and toast on a gridiron, or fry in their own fat.",
      "section": null
    }
  ],
