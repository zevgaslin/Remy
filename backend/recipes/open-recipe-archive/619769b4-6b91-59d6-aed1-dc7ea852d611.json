  "instructions": [
    {
      "text": "Seed and chop finely 1 cup raisins; flour these and set them aside",
      "section": null
    },
    {
      "text": "Beat together 1 1/2 cups brown sugar and 1 cup shortening (butter and lard mixed)",
      "section": null
    },
    {
      "text": "When creamy, add 1 beaten egg, 4 tablespoons sweet milk, 1 teaspoon baking soda and enough flour to make a stiff batter",
      "section": null
    },
    {
      "text": "Add floured raisins with grated nutmeg, cinnamon and ground cloves to taste",
      "section": null
    },
    {
      "text": "Add enough more flour to make a stiff dough",
      "section": null
    },
    {
      "text": "Roll rather thin and bake in quick oven",
      "section": null
    }
