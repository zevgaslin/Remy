  "instructions": [
    {
      "text": "Wipe steak, sprinkle with salt and pepper, place on a greased broiler, and broil five minutes.",
      "section": null
    },
    {
      "text": "Fry onion and carrot in two tablespoons butter for five minutes.",
      "section": null
    },
    {
      "text": "Add flour and stir until well browned.",
      "section": null
    },
    {
      "text": "Add Brown Stock, parsley, bay leaf, peppercorns, and salt.",
      "section": null
    },
    {
      "text": "Let simmer twenty minutes and strain.",
      "section": null
    },
    {
      "text": "Add Madeira wine, boiled French chestnuts, and one tablespoon butter.",
      "section": null
    },
    {
      "text": "Pour sauce over steak on hot platter.",
      "section": null
    }
