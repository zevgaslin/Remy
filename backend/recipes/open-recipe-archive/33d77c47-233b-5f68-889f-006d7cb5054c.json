  "instructions": [
    {
      "text": "Wash the oysters in the water and drain into a stewpan",
      "section": null
    },
    {
      "text": "Put this liquor on to heat",
      "section": null
    },
    {
      "text": "As soon as it comes to a boil, skim and set back",
      "section": null
    },
    {
      "text": "Put the butter in a frying pan and when hot, put in the steak",
      "section": null
    },
    {
      "text": "Cook ten minutes",
      "section": null
    },
    {
      "text": "Take up the steak and stir the flour into the butter remaining in the pan",
      "section": null
    },
    {
      "text": "Stir until a dark brown",
      "section": null
    },
    {
      "text": "Add the oyster liquor and boil one minute",
      "section": null
    },
    {
      "text": "Season with salt and pepper",
      "section": null
    },
    {
      "text": "Put back the steak and cover the pan",
      "section": null
    },
    {
      "text": "Simmer half an hour or until the steak seems tender",
      "section": null
    },
    {
      "text": "Add the oysters and lemon juice",
      "section": null
    },
    {
      "text": "Boil one minute",
      "section": null
    },
    {
      "text": "Serve on a hot dish with points of toast for a garnish",
      "section": null
    }
