  "instructions": [
    {
      "text": "Chop or grind the meat and suet; season, and stuff into beef-skins",
      "section": null
    },
    {
      "text": "Tie these up; prick each in several places to allow the escape of the steam",
      "section": null
    },
    {
      "text": "Put into hot—not boiling water, and heat gradually to the boiling-point",
      "section": null
    },
    {
      "text": "Cook slowly for one hour",
      "section": null
    },
    {
      "text": "Take out the skins and lay them to dry in the sun, upon clean, sweet straw or hay",
      "section": null
    },
    {
      "text": "Rub the outside of the skins with oil or melted butter, and hang in a cool, dry cellar",
      "section": null
    },
    {
      "text": "If you mean to keep it more than a week, rub pepper or powdered ginger upon the outside",
      "section": null
    },
    {
      "text": "You can wash it off before sending to table",
      "section": null
    },
    {
      "text": "Cut in round slices, and lay sliced lemon around the edge of the dish",
      "section": null
    }
  ],
