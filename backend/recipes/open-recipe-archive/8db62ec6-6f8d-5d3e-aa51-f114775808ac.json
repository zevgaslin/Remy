  "instructions": [
    {
      "text": "Put them into a pot with three or four quarts of water, two carrots, three turnips, one onion, a few cloves, pepper and salt",
      "section": null
    },
    {
      "text": "Boil the whole gently four hours",
      "section": null
    },
    {
      "text": "Strain it through a colander, mashing the vegetables so that they will all pass through",
      "section": null
    },
    {
      "text": "Skim off the fat, and return the soup to the pot",
      "section": null
    },
    {
      "text": "Mix one tablespoonful of flour with two of water, stir it into the soup and boil the whole ten minutes",
      "section": null
    },
    {
      "text": "Serve this soup with sippits of toast",
      "section": null
    }
