  "instructions": [
    {
      "text": "Scrape and slice three turnips and three carrots and peel three onions, and fry all with a little butter until a light yellow.",
      "section": null
    },
    {
      "text": "Add a bunch of celery and three or four leeks cut in pieces.",
      "section": null
    },
    {
      "text": "Stir and fry all the ingredients for six minutes.",
      "section": null
    },
    {
      "text": "When fried, add one clove of garlic, two stalks of parsley, two cloves, salt, pepper and a little grated nutmeg.",
      "section": null
    },
    {
      "text": "Cover with three quarts of water and simmer for three hours, taking off the scum carefully.",
      "section": null
    },
    {
      "text": "Strain and use.",
      "section": null
    }
