  "instructions": [
    {
      "text": "Scald flour, white sugar and salt with the water of the potatoes, add 1 quart of mashed potatoes and 3 quarts of boiling water and when cool enough add 1 White Swan Yeast Cake.",
      "section": null
    },
    {
      "text": "Set in a warm place to rise over night.",
      "section": null
    },
    {
      "text": "In the morning put this yeast into your flour (have the flour warm), mix stiff, let rise 1 hour, mix down, let rise 1 hour, then put in pans.",
      "section": null
    },
    {
      "text": "Let rise and bake.",
      "section": null
