  "instructions": [
    {
      "text": "Wipe and cut the meat and bones into small pieces",
      "section": null
    },
    {
      "text": "Put the marrow, bones, and part of the meat in the kettle, with four quarts of cold water",
      "section": null
    },
    {
      "text": "Heat slowly; cut the onions and vegetables fine, and fry them in the ham fat or in drippings, then brown the remainder of the meat",
      "section": null
    },
    {
      "text": "Add onions, meat, herbs, spices and vegetables",
      "section": null
    },
    {
      "text": "Simmer until the meat is in rags; it will take about seven hours",
      "section": null
    },
    {
      "text": "Strain, and when cold remove the fat and add the whites and shells of the eggs, lemon and salt and pepper, if needed",
      "section": null
    },
    {
      "text": "When well mixed heat it, and boil ten minutes",
      "section": null
    },
    {
      "text": "Strain through fine strainer, and heat again to the boiling point before serving",
      "section": null
    },
    {
      "text": "Serve clear, or with wine or lemon",
      "section": null
    }
