  "instructions": [
    {
      "text": "Bake in thin layers as for jelly-cake.",
      "section": null
    },
    {
      "text": "Heat the milk to boiling, and stir in the corn-starch, wet with a little cold milk.",
      "section": null
    },
    {
      "text": "Take out a little and mix gradually with the beaten egg and sugar.",
      "section": null
    },
    {
      "text": "Return to the rest of the custard, and boil, stirring constantly until quite thick.",
      "section": null
    },
    {
      "text": "Let it cool before you season, and spread on cake.",
      "section": null
    },
    {
      "text": "Season the icing also with vanilla.",
      "section": null
    },
    {
      "text": "Spread between the layers when cold.",
      "section": null
    }
