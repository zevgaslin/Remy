  "instructions": [
    {
      "text": "Mix together one cup chopped apple, one-half cup raisins seeded and chopped, one-half cup currants, one-fourth cup butter, one tablespoon molasses, one tablespoon boiled cider, one cup sugar, one teaspoon cinnamon, one-half teaspoon cloves, one-half nutmeg grated, one salt-spoon of mace, and one teaspoon salt.",
      "section": null
    },
    {
      "text": "Add enough stock in which meat was cooked to moisten; heat gradually to boiling-point, and simmer one hour.",
      "section": null
    },
    {
      "text": "Add one cup chopped meat and two tablespoons Barberry Jelly.",
      "section": null
    },
    {
      "text": "Cook fifteen minutes.",
      "section": null
    }
  ],
