  "instructions": [
    {
      "text": "Stir two teaspoonfuls baking powder and a little salt into one pint of flour",
      "section": null
    },
    {
      "text": "Sift and stir the mixture into milk, until very soft",
      "section": null
    },
    {
      "text": "Place well-greased cups in a steamer",
      "section": null
    },
    {
      "text": "Put in each a spoonful of the batter, then add one of berries or steamed apples",
      "section": null
    },
    {
      "text": "Cover with another spoonful of batter",
      "section": null
    },
    {
      "text": "Steam twenty minutes",
      "section": null
    },
    {
      "text": "For sauce: beat two eggs, half a cup butter, a cup of sugar thoroughly with a cup of boiling milk and one cup of strawberries",
      "section": null
    }
