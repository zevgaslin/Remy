  "instructions": [
    {
      "text": "Mix one large teacupful of cracker crumbs, one quart of milk, one spoonful of flour, a pinch of salt, the yolks of three eggs, one whole egg and half a cupful of sugar",
      "section": null
    },
    {
      "text": "Flavor with vanilla, adding a little pinch of salt",
      "section": null
    },
    {
      "text": "Bake in a moderate oven",
      "section": null
    },
    {
      "text": "When done, spread over the top, while hot, a pint of well-sugared raspberries",
      "section": null
    },
    {
      "text": "Beat the whites of the three eggs very stiff, with two tablespoonfuls of sugar, a little lemon extract, or whatever one prefers",
      "section": null
    },
    {
      "text": "Spread this over the berries and bake a light brown",
      "section": null
    },
    {
      "text": "Serve with fruit sauce made of raspberries",
      "section": null
    }
