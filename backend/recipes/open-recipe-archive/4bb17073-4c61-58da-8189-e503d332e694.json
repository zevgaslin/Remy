  "instructions": [
    {
      "text": "Soak lentils and dried lima beans overnight in cold water to cover; drain, add three pints water, one-half small onion, one stalk celery, three slices carrot, and a sprig of parsley.",
      "section": null
    },
    {
      "text": "Cook until lentils are soft, remove seasonings, drain, and rub through a sieve.",
      "section": null
    },
    {
      "text": "To pulp add one-half cup stale bread crumbs, one egg slightly beaten, and salt and pepper to taste.",
      "section": null
    },
    {
      "text": "Melt one tablespoon butter, add one tablespoon flour, and pour on gradually one-third cup hot cream; combine mixtures, and cool.",
      "section": null
    },
    {
      "text": "Shape, dip in crumbs, egg, and crumbs again, fry in deep fat, and drain on brown paper.",
      "section": null
    },
    {
      "text": "Serve with Tomato Sauce I.",
      "section": null
    }
  ],
