  "instructions": [
    {
      "text": "Cut one slice bacon in small pieces and cook five minutes with two tablespoons butter.",
      "section": null
    },
    {
      "text": "Remove bacon and add one finely chopped shallot.",
      "section": null
    },
    {
      "text": "Fry two minutes.",
      "section": null
    },
    {
      "text": "Add six chickens' livers cleaned and separated and cook two minutes.",
      "section": null
    },
    {
      "text": "Add two tablespoons flour, one cup Brown Stock, one teaspoon lemon juice, and one-fourth cup sliced mushrooms.",
      "section": null
    },
    {
      "text": "Cook two minutes, turn into a serving dish, and sprinkle with finely chopped parsley.",
      "section": null
