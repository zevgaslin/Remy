  "instructions": [
    {
      "text": "Cream together one scant cup of butter and three cups of sugar.",
      "section": null
    },
    {
      "text": "Add one cup of milk, then the beaten whites of twelve eggs.",
      "section": null
    },
    {
      "text": "Sift three teaspoonfuls of baking powder into one cup of cornstarch mixed with three cups of sifted flour and beat in gradually with the rest.",
