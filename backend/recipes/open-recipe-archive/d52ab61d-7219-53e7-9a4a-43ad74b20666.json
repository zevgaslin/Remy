  "instructions": [
    {
      "text": "Mix molasses with the spices in it and steep gently twenty or thirty minutes, not boiling hot",
      "section": null
    },
    {
      "text": "Beat the eggs very lightly",
      "section": null
    },
    {
      "text": "Flour the fruit well",
      "section": null
    },
    {
      "text": "Dissolve soda in water",
      "section": null
    },
    {
      "text": "Put the fruit in last, stirring it gradually and adding the dissolved soda",
      "section": null
    },
    {
      "text": "Add flour after the fruit is in if necessary",
      "section": null
    },
    {
      "text": "Butter a sheet of paper and lay it in the pan",
      "section": null
    },
    {
      "text": "Lay in some slices of citron, then a layer of the mixture, then of citron again, etc., till the pan is nearly full",
      "section": null
    },
    {
      "text": "Bake three or four hours, according to the thickness of the loaves, in a tolerably hot oven, and with steady heat",
      "section": null
    },
    {
      "text": "Let it cool in the oven gradually",
      "section": null
    },
    {
      "text": "Ice when cold",
      "section": null
    }
