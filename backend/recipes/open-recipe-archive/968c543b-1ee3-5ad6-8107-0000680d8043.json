  "instructions": [
    {
      "text": "Mix 2 cups molasses, 1 cup brown sugar, 1 cup lard, 1/2 cup sour cream, 1 teaspoon soda, and 2 teaspoons ginger",
      "section": null
    },
    {
      "text": "Stir thick and roll out a sheet long enough to fill a pan",
      "section": null
    },
    {
      "text": "Bake quickly",
      "section": null
    },
    {
      "text": "For icing: Mix 1 cup brown sugar, 3 tablespoons water, 1 teaspoon butter, and a few drops vanilla",
      "section": null
    },
    {
      "text": "Ice the whole sheet and cut in squares",
      "section": null
    }
