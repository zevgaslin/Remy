  "instructions": [
    {
      "text": "Cook one shallot, finely chopped, with one-fourth cup claret until claret is reduced to two tablespoons, and strain.",
      "section": null
    },
    {
      "text": "Melt two tablespoons butter, add one slice onion, two slices carrot, sprig of parsley, bit of bay leaf, eight peppercorns, and one clove, and cook until brown.",
      "section": null
    },
    {
      "text": "Add three and one-half tablespoons flour, and when well browned add gradually one cup Brown Stock.",
      "section": null
    },
    {
      "text": "Strain, let simmer eight minutes, add claret and one tablespoon butter.",
      "section": null
    },
    {
      "text": "Season with salt and pepper.",
      "section": null
    },
    {
      "text": "Remove marrow from a marrow-bone and cut in one-third inch slices; then poach in boiling water.",
      "section": null
    },
    {
      "text": "Broil porterhouse steak.",
      "section": null
    },
    {
      "text": "Arrange marrow on and around steak, and pour around sauce.",
      "section": null
    }
  ],
