  "instructions": [
    {
      "text": "Make dough with 2 quarts flour, 2 teaspoons cream tartar, 1 teaspoon soda, mixed with milk or cold water as for biscuit with no lard",
      "section": null
    },
    {
      "text": "Roll about 1 inch thick and cut into 4-inch squares",
      "section": null
    },
    {
      "text": "Cut meat into small pieces",
      "section": null
    },
    {
      "text": "Put in a layer of beef in bottom of pot",
      "section": null
    },
    {
      "text": "Add alternating layers of carrots, turnip, potatoes, dough and meat",
      "section": null
    },
    {
      "text": "Add salt, pepper, and a little summer savory",
      "section": null
    },
    {
      "text": "Add water until you see it through the vegetables",
      "section": null
    },
    {
      "text": "Cook slowly 3 hours",
      "section": null
    }
