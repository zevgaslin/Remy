  "instructions": [
    {
      "text": "Make syrup by boiling quart of water and sugar twenty minutes.",
      "section": null
    },
    {
      "text": "Separate mint in pieces, add to the boiling water, cover, and let stand in warm place five minutes, strain, and add to syrup.",
