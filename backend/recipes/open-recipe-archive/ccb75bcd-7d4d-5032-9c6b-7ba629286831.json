  "instructions": [
    {
      "text": "Peel and slice two potatoes, parboil them in enough hot water to cover them",
      "section": null
    },
    {
      "text": "While they are cooking, chop two tomatoes, slice the corn off two ears of corn, and add one slice of onion",
      "section": null
    },
    {
      "text": "Drain the potatoes, and put all on to cook in two quarts of cold water",
      "section": null
    },
    {
      "text": "When done, rub all through a colander, return the soup to the pot",
      "section": null
    },
    {
      "text": "Add a level tablespoonful butter, one teaspoon salt, one-half teaspoon pepper and one of minced parsley",
      "section": null
    },
    {
      "text": "If not thick enough, moisten a teaspoonful of flour with cold water, thin with the soup and stir in; let boil up once, and it is ready for the table",
      "section": null
    }
