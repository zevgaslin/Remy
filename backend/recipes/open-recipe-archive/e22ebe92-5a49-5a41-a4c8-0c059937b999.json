  "instructions": [
    {
      "text": "Put 1 3/4 cups cold water, celery, carrot, beef extract dissolved in 1 cup hot water, onion, bay leaf, cloves, and parsley in a saucepan",
      "section": null
    },
    {
      "text": "Cover and let simmer 3/4 hour",
      "section": null
    },
    {
      "text": "Soak 1 ounce gelatine in 3/4 cup water for an hour",
      "section": null
    },
    {
      "text": "Add gelatine to saucepan and stir until dissolved",
      "section": null
    },
    {
      "text": "Season with tablespoon sherry or tarragon vinegar",
      "section": null
    },
    {
      "text": "If deeper color is desired, add a few drops kitchen bouquet or caramel",
      "section": null
    },
    {
      "text": "Clear if necessary and strain through double cloth",
      "section": null
    },
    {
      "text": "If for moulding use at once; if for garnishing, turn into a shallow pan to set",
      "section": null
    },
    {
      "text": "Can be stamped or cut into fancy shapes more easily if cooked in layers of right thickness",
      "section": null
    },
    {
      "text": "Observe always the proportion of 2 ounces gelatine to 6 cups liquid",
      "section": null
    }
