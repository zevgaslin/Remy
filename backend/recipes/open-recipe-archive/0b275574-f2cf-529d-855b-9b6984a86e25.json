  "instructions": [
    {
      "text": "Peel and slice onions very fine. Pour cold water over them and press hard to remove the strong taste. Drain well.",
      "section": null
    },
    {
      "text": "Have ready in the salad bowl cold boiled or baked beans, preferably the latter.",
      "section": null
    },
    {
      "text": "Mix with them the minced onion, salt, pepper, salad oil, sugar and vinegar.",
      "section": null
    },
    {
      "text": "Toss and mix with a fork lightly, but thoroughly, and garnish with olives, two hard-boiled eggs sliced and lettuce leaves.",
      "section": null
    }
