  "instructions": [
    {
      "text": "Combine 4 cups raisins, 3 cups sugar, 4 cups currants, 1/2 pound lemon peel, 1 cup molasses, 2 cups buttermilk, 1 pound butter, 1 teaspoon soda, 2 teaspoons baking powder, 2 teaspoons cinnamon, 1 teaspoon cloves and 1 teaspoon nutmeg.",
      "section": null
    },
    {
      "text": "Bake with slow fire.",
      "section": null
    },
    {
      "text": "For White Part: beat 1 cup granulated sugar, a saltspoon salt, butter size of an egg, and 1/2 cup milk together.",
      "section": null
    },
    {
      "text": "Fold in 1 1/2 cups flour and the whites of 3 eggs beaten light with 1 teaspoon baking powder.",
      "section": null
    },
    {
      "text": "Bake in layers.",
      "section": null
    },
    {
      "text": "Put together with fruit part and ice with caramel frosting.",
      "section": null
    }
  ],
