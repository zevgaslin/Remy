  "instructions": [
    {
      "text": "Put three tablespoonfuls of butter in a saucepan",
      "section": null
    },
    {
      "text": "Add three tablespoonfuls of sifted flour, quarter of a teaspoonful of nutmeg, ten peppercorns, a teaspoonful of salt",
      "section": null
    },
    {
      "text": "Beat all well together",
      "section": null
    },
    {
      "text": "Add three slices of onion, two slices of carrot, two sprigs of parsley, two of thyme, a bay leaf and half a dozen mushrooms cut up",
      "section": null
    },
    {
      "text": "Moisten the whole with a pint of stock or water and a cup of sweet cream",
      "section": null
    },
    {
      "text": "Set it on the stove and cook slowly for half an hour, watching closely that it does not burn",
      "section": null
    },
    {
      "text": "Strain through a sieve",
      "section": null
    }
