  "instructions": [
    {
      "text": "rub the chocolate smooth in the milk and heat to boiling over the fire",
      "section": null
    },
    {
      "text": "then stir in the cornstarch",
      "section": null
    },
    {
      "text": "Stir five minutes until well thickened, remove from the fire and pour into a bowl",
      "section": null
    },
    {
