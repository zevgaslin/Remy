  "instructions": [
    {
      "text": "Pound and squeeze enough blackberries through a coarse muslin bag to make a quart of juice",
      "section": null
    },
    {
      "text": "Put this into an agate-iron or porcelain-lined kettle, with a pound of sugar",
      "section": null
    },
    {
      "text": "Tie the spices up in little thin muslin bags",
      "section": null
    },
    {
      "text": "Stir the sugar until dissolved",
      "section": null
    },
    {
      "text": "Set over the fire and cook together, after the boil begins, fifteen minutes",
      "section": null
    },
    {
      "text": "Take off the scum",
      "section": null
    },
    {
      "text": "Turn into a jar, and cover closely while it cools",
      "section": null
    },
    {
      "text": "When perfectly cold strain out the spices",
      "section": null
    },
    {
      "text": "Add a pint of good brandy",
      "section": null
    },
    {
      "text": "Bottle and seal",
      "section": null
    }
