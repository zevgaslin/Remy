  "instructions": [
    {
      "text": "Boil the eggs quite hard, and chop the yolks very fine.",
      "section": null
    },
    {
      "text": "Chop the pippins and sultana raisins.",
      "section": null
    },
    {
      "text": "Add the currants, sugar, powdered cinnamon, beaten mace, powdered nutmegs, juice and grated peel of lemons, and citron cut in large strips.",
      "section": null
