  "instructions": [
    {
      "text": "Warm the butter slightly to make it beat easily, but not oily",
      "section": null
    },
    {
      "text": "Put it into a bowl with the sugar and beat both to a cream",
      "section": null
    },
    {
      "text": "Sift the flour and mix it in, a tablespoon at a time",
      "section": null
    },
    {
      "text": "Add the currants washed and dried, the peel chopped fine, the ground almonds and the soda",
      "section": null
    },
    {
      "text": "When all these are mixed, add the yolks beaten to a froth",
      "section": null
    },
    {
      "text": "Mix for five minutes",
      "section": null
    },
    {
      "text": "Add the whites of the eggs beaten to a froth",
      "section": null
    },
    {
