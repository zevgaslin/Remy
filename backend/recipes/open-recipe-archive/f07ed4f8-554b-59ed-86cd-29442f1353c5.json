  "instructions": [
    {
      "text": "Stir three cups milk, two cups sugar, and one cup yeast to a batter and let stand over night",
      "section": null
    },
    {
      "text": "In the morning add two cups sugar, two cups butter, three eggs, half a nutmeg, one tablespoonful cinnamon, one pound raisins, and a gill of brandy",
      "section": null
    },
    {
      "text": "Dissolve a half-teaspoonful of soda in a tablespoonful of milk in the morning",
      "section": null
    },
    {
      "text": "Pour into greased pans and let rise until quite light before baking",
      "section": null
    },
    {
      "text": "Bake until done",
