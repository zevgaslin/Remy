  "instructions": [
    {
      "text": "Line a deep biscuit pan with pastry made with 1 part ice-cold water and one part of thick sour cream, with 1 teaspoon soda and 2 of cream of tartar to 1 quart of flour",
      "section": null
    },
    {
      "text": "Bone the chicken and distribute white and dark meat evenly over crust",
      "section": null
    },
    {
      "text": "Sprinkle rolled crackers 1/2 inch in depth over meat when pan was half filled",
      "section": null
    },
    {
      "text": "Simmer broth to good strength, thicken and season as for gravy",
      "section": null
    },
    {
      "text": "Pour in pan enough to nearly cover second layer of meat",
      "section": null
    },
    {
      "text": "Leave opening in top crust for escape of steam",
      "section": null
    },
    {
      "text": "Bake 40 minutes",
      "section": null
    }
