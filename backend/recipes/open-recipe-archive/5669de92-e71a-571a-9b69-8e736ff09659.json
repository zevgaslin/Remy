  "instructions": [
    {
      "text": "Dissolve gelatine in one-half pint cold water",
      "section": null
    },
    {
      "text": "Add sugar and lemon juice, with boiling water",
      "section": null
    },
    {
      "text": "Let this stand until the jelly begins to thicken",
      "section": null
    },
    {
      "text": "Pour a little into the mould",
      "section": null
    },
    {
      "text": "Place on it a layer of peaches, cut any shape desired",
      "section": null
    },
    {
      "text": "Put in more jelly and fruit, alternately until the mould is filled",
      "section": null
    },
    {
      "text": "Place on ice to set",
      "section": null
    },
    {
      "text": "Serve with whipped cream",
      "section": null
    },
    {
      "text": "Allow each layer of fruit and jelly to set before putting in another, so that the fruit will not fall together",
      "section": null
    }
