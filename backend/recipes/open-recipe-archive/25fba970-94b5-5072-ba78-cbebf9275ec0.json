  "instructions": [
    {
      "text": "Cut a slice from stem end of each pepper, remove seeds, and parboil peppers, fifteen minutes.",
      "section": null
    },
    {
      "text": "Cook onion in butter three minutes; add mushrooms and ham, and cook one minute, then add Brown Sauce and bread crumbs.",
      "section": null
    },
    {
      "text": "Cool mixture, sprinkle peppers with salt, fill with cooked mixture, cover with buttered bread crumbs and bake ten minutes.",
      "section": null
