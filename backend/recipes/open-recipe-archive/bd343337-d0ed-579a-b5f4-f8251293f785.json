  "instructions": [
    {
      "text": "For the cake: Combine 3 cups sugar, 1½ cups butter, 1 cup milk, 4½ cups prepared flour, and 5 eggs and bake as for jelly-cake.",
      "section": null
    },
    {
      "text": "For the caramel filling: Boil together 1½ cup brown sugar, ½ cup milk, 1 cup molasses, 1 teaspoonful butter, 1 tablespoonful flour, and 2 tablespoonfuls cold water for five minutes.",
      "section": null
    },
    {
      "text": "Add half a cake Baker's chocolate (grated), and boil until it is the consistency of rich custard.",
      "section": null
    },
    {
      "text": "Add a pinch of soda, stir well, and remove from fire.",
      "section": null
    },
    {
      "text": "When cold, flavor with a large teaspoonful vanilla, and spread between the layers of cake.",
      "section": null
    },
    {
      "text": "Cover the top with the same, and set in an open, sunny window to dry.",
      "section": null
    }
  ],
