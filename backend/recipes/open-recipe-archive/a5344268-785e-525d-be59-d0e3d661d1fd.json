  "instructions": [
    {
      "text": "Make biscuit dough with 1 quart flour, 2 large teaspoons baking powder, 1/2 teaspoon salt, 4 tablespoons lard and 1 cup sweet milk",
      "section": null
    },
    {
      "text": "Roll out to about 1/4 inch thick",
      "section": null
    },
    {
      "text": "Spread with 2 tablespoons butter, 1 cup sugar, mixed with 1 large teaspoon cinnamon, 1 cup currants",
      "section": null
    },
    {
      "text": "Give a light roll with rolling-pin to keep the currants from dropping out",
      "section": null
    },
    {
      "text": "Roll as you would a jelly roll",
      "section": null
    },
    {
      "text": "Cut in slices about 1 inch thick",
      "section": null
    },
    {
      "text": "Place in pan and bake a light brown",
      "section": null
    },
    {
      "text": "Glaze with a spoonful of milk and sugar",
      "section": null
    }
